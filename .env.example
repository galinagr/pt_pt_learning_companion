# No MODEL_API_KEY -> offline stub. Set MODEL_API_KEY -> Meta Model API.
# Keep this .env file local (never commit it).
# MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3
